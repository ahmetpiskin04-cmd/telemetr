{
  "name": "telemetr",
  "version": "0.1.0",
  "private": true,
  "description": "BİST hisseleri, fiziksel altın/gümüş ve yatırım fonları için lokal fiyat veritabanı ve teknik analiz",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "shortcut": "node scripts/install-shortcut.js",
    "start": "vite build && node scripts/dev.js --prod",
    "sync": "node --disable-warning=ExperimentalWarning scripts/sync.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "analyze": "node --disable-warning=ExperimentalWarning scripts/analyze.js",
    "alarm:test": "node --disable-warning=ExperimentalWarning scripts/alarm-simulate.js",
    "ai": "node --disable-warning=ExperimentalWarning --env-file-if-exists=%USERPROFILE%\\.evim\\telemetr.env --env-file-if-exists=.env scripts/ai-report.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "dist:dir": "vite build && electron-builder --win dir",
    "dist": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "yahoo-finance2": "^4.0.4"
  },
  "author": "Telemetr",
  "build": {
    "appId": "com.telemetr.app",
    "productName": "Telemetr",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "src/**",
      "dist/renderer/**",
      "examples/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Telemetr-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Telemetr-${version}.${ext}"
    }
  }
}
