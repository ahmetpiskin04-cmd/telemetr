# Bu dosyayı .env olarak kopyalayıp anahtarları girin. .env'i kimseyle paylaşmayın.
AI_PROVIDER=openai

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Fiyat alarmları: Telegram bildirimi (isteğe bağlı). Anahtarları proje dışında tutmak için
# %USERPROFILE%\.evim\telemetr.env dosyasına yazın; token ve chat id kodda ya da depoda durmaz.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
